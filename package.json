{
  "name": "chainpack-rush",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Chainpack Rush - 30-Second Loot Chains",
  "scripts": {
    "dev": "vite --host",
    "build": "npm run glyphs && tsc --noEmit && vite build",
    "build:trial": "npm run glyphs && tsc --noEmit && VITE_CHALLENGE_OPEN=1 vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "sim": "tsx tools/sim.ts",
    "cap:sync": "npm run build && cap sync",
    "assets": "capacitor-assets generate --ios --android --iconBackgroundColor '#14121c' --iconBackgroundColorDark '#14121c' --splashBackgroundColor '#14121c' --splashBackgroundColorDark '#14121c'",
    "store-assets": "tsx tools/genStoreAssets.ts",
    "glyphs": "tsx tools/genGlyphs.ts",
    "predev": "npm run glyphs",
    "playtest": "tsx tools/playtest.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "firebase": "^11.10.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
